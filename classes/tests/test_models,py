from django.core.exceptions import ValidationError
from django.test import TestCase
from django.utils import timezone

from classes.models import Class, ClassTeacher
from schools.models import School
from terms.models import Term
from users.models import User


def make_school():
    return School.objects.create(name='مدرسه تست')


def make_term(school=None):
    return Term.objects.create(
        start_date='2024-01-01',
        end_date='2024-06-30',
        term_type='regular',
    )


def make_class(school=None, term=None):
    school = school or make_school()
    term = term or make_term()
    return Class.objects.create(
        school=school,
        term=term,
        subject='ریاضی',
        duration=60,
    )


def make_teacher(username='teacher1'):
    return User.objects.create_user(
        username=username,
        password='pass123',
        role='teacher',
        phone_number='+989111111111',
        emergency_number='+989222222222',
    )


class ClassModelTests(TestCase):
    def test_create_class(self):
        cls = make_class()
        self.assertEqual(cls.subject, 'ریاضی')
        self.assertEqual(cls.duration, 60)
        self.assertFalse(cls.is_deleted)
        self.assertIsNone(cls.deleted_at)

    def test_str(self):
        cls = make_class()
        self.assertIn('ریاضی', str(cls))
        self.assertIn('60min', str(cls))

    def test_invalid_duration_is_rejected_at_full_clean(self):
        school = make_school()
        term = make_term()
        cls = Class(school=school, term=term, subject='علوم', duration=45)
        with self.assertRaises(ValidationError):
            cls.full_clean()

    def test_soft_delete(self):
        cls = make_class()
        before = timezone.now()
        cls.soft_delete()
        cls.refresh_from_db()

        self.assertTrue(cls.is_deleted)
        self.assertIsNotNone(cls.deleted_at)
        self.assertGreaterEqual(cls.deleted_at, before)

    def test_soft_deleted_excluded_from_objects(self):
        cls = make_class()
        cls.soft_delete()

        self.assertEqual(Class.objects.filter(pk=cls.pk).count(), 0)

    def test_soft_deleted_visible_in_all_objects(self):
        cls = make_class()
        cls.soft_delete()

        self.assertTrue(Class.all_objects.get(pk=cls.pk).is_deleted)

    def test_hard_delete_removes_from_db(self):
        cls = make_class()
        pk = cls.pk
        cls.delete()
        self.assertFalse(Class.all_objects.filter(pk=pk).exists())


class ClassTeacherModelTests(TestCase):

    def setUp(self):
        self.school = make_school()
        self.term = make_term()
        self.cls = make_class(self.school, self.term)
        self.teacher1 = make_teacher('teacher1')
        self.teacher2 = make_teacher('teacher2')


    def _make_assignment(self, teacher, start, end=None, cls=None):
        ct = ClassTeacher(
            class_obj=cls or self.cls,
            teacher=teacher,
            start_date=start,
            end_date=end,
        )
        ct.full_clean()
        ct.save()
        return ct


    def test_end_before_start_raises(self):
        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher1,
            start_date='2024-03-10',
            end_date='2024-03-05',
        )
        with self.assertRaises(ValidationError) as ctx:
            ct.full_clean()
        self.assertIn('end_date', str(ctx.exception).lower() or str(ctx.exception))

    def test_end_equal_start_raises(self):
        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher1,
            start_date='2024-03-10',
            end_date='2024-03-10',
        )
        with self.assertRaises(ValidationError):
            ct.full_clean()

    def test_end_after_start_is_valid(self):
        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher1,
            start_date='2024-03-01',
            end_date='2024-06-01',
        )
        ct.full_clean() 

    def test_open_ended_assignment_is_valid(self):
        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher1,
            start_date='2024-03-01',
            end_date=None,
        )
        ct.full_clean() 



    def test_exact_same_range_overlaps(self):
        self._make_assignment(self.teacher1, '2024-03-01', '2024-05-31')

        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher2,
            start_date='2024-03-01',
            end_date='2024-05-31',
        )
        with self.assertRaises(ValidationError):
            ct.full_clean()

    def test_partial_overlap_start_inside_existing(self):
        self._make_assignment(self.teacher1, '2024-01-01', '2024-04-30')

        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher2,
            start_date='2024-03-01',  
            end_date='2024-06-30',
        )
        with self.assertRaises(ValidationError):
            ct.full_clean()

    def test_partial_overlap_end_inside_existing(self):
        self._make_assignment(self.teacher1, '2024-03-01', '2024-06-30')

        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher2,
            start_date='2024-01-01',
            end_date='2024-04-15',  
        )
        with self.assertRaises(ValidationError):
            ct.full_clean()

    def test_new_range_fully_contains_existing(self):
        self._make_assignment(self.teacher1, '2024-03-01', '2024-04-30')

        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher2,
            start_date='2024-01-01',
            end_date='2024-06-30',
        )
        with self.assertRaises(ValidationError):
            ct.full_clean()

    def test_existing_open_ended_blocks_any_later_start(self):
        self._make_assignment(self.teacher1, '2024-01-01', None)

        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher2,
            start_date='2024-06-01',
            end_date=None,
        )
        with self.assertRaises(ValidationError):
            ct.full_clean()

    def test_new_open_ended_overlaps_existing_fixed(self):
        self._make_assignment(self.teacher1, '2024-03-01', '2024-06-30')

        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher2,
            start_date='2024-05-01',
            end_date=None,
        )
        with self.assertRaises(ValidationError):
            ct.full_clean()

    def test_adjacent_ranges_do_not_overlap(self):
        self._make_assignment(self.teacher1, '2024-01-01', '2024-03-31')

        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher2,
            start_date='2024-04-01',
            end_date='2024-06-30',
        )
        ct.full_clean()
        ct.save()
        self.assertEqual(ClassTeacher.objects.filter(class_obj=self.cls).count(), 2)

    def test_same_teacher_sequential_assignments_allowed(self):
        self._make_assignment(self.teacher1, '2024-01-01', '2024-03-31')

        ct = ClassTeacher(
            class_obj=self.cls,
            teacher=self.teacher1,  
            start_date='2024-04-01',
            end_date='2024-06-30',
        )
        ct.full_clean()
        ct.save()

    def test_no_overlap_different_classes(self):
    
        other_class = Class.objects.create(
            school=self.school,
            term=self.term,
            subject='فیزیک',
            duration=90,
        )
        self._make_assignment(self.teacher1, '2024-01-01', '2024-06-30', cls=self.cls)

        ct = ClassTeacher(
            class_obj=other_class,
            teacher=self.teacher1,
            start_date='2024-01-01',
            end_date='2024-06-30',
        )
        ct.full_clean()
        ct.save()

    def test_update_does_not_conflict_with_self(self):
        ct = self._make_assignment(self.teacher1, '2024-01-01', '2024-06-30')
        ct.end_date = '2024-05-31'
        ct.full_clean()  
        ct.save()


    def test_soft_delete_class_teacher(self):
        ct = self._make_assignment(self.teacher1, '2024-01-01', '2024-06-30')
        ct.soft_delete()
        ct.refresh_from_db()

        self.assertTrue(ct.is_deleted)
        self.assertIsNotNone(ct.deleted_at)

    def test_soft_deleted_assignment_excluded_from_objects(self):
        ct = self._make_assignment(self.teacher1, '2024-01-01', '2024-03-31')
        ct.soft_delete()

        self.assertEqual(ClassTeacher.objects.filter(pk=ct.pk).count(), 0)

    def test_soft_deleted_visible_in_all_objects(self):
        ct = self._make_assignment(self.teacher1, '2024-01-01', '2024-03-31')
        ct.soft_delete()

        self.assertTrue(ClassTeacher.all_objects.get(pk=ct.pk).is_deleted)
